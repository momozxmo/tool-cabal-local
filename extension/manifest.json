{
  "manifest_version": 3,
  "name": "All for Cabal — Aztek Session Bridge",
  "version": "1.0.0",
  "description": "Import your Aztek login session into All for Cabal Web using a one-time pairing token.",
  "permissions": ["cookies", "tabs", "scripting"],
  "host_permissions": [
    "https://*.combo-interactive.com/*",
    "https://combo-interactive.com/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.combo-interactive.com/*",
        "https://combo-interactive.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "All for Cabal — Aztek Session Bridge"
  }
}
